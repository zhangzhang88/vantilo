{
  "name": "vantilo",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "workspaces": ["packages/reader"],
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "build:app-icon": "node scripts/build-app-icon.mjs",
    "typecheck": "tsc -b --pretty && npm run typecheck --workspace=@vantilo/reader",
    "test": "vitest run",
    "test:e2e:codex": "node scripts/verify-real-codex-tools.cjs",
    "test:e2e:codex:passage": "node scripts/verify-real-codex-passage.cjs",
    "desktop": "electron .",
    "desktop:dev": "node scripts/build-reader-dev.mjs && node electron/dev.cjs",
    "build:reader": "node scripts/build-reader.mjs",
    "package:mac": "npm run build && npm run build:reader && node scripts/package-mac.mjs",
    "build:mac:beta": "node scripts/build-mac-beta-candidates.mjs",
    "build:mac:universal": "npm run build && npm run build:reader && node scripts/build-mac-universal.mjs",
    "package:reader:preview": "node scripts/package-reader-setup-preview.mjs",
    "stage:qwen:health": "node scripts/stage-reader-qwen-health.mjs",
    "package:qwen:preview": "node scripts/package-reader-qwen-preview.mjs",
    "test:qwen:preview": "node node_modules/electron/cli.js scripts/verify-reader-qwen-preview.cjs",
    "test:qwen:resident": "node node_modules/electron/cli.js scripts/verify-reader-qwen-resident.cjs",
    "test:reader:preview": "node node_modules/electron/cli.js scripts/verify-reader-setup-preview.cjs",
    "test:reader:layout": "node node_modules/electron/cli.js scripts/verify-reader-layout.cjs",
    "test:reader:growth-page": "node node_modules/electron/cli.js scripts/verify-reader-growth-page-live.cjs",
    "test:reader:growth-navigation": "node node_modules/electron/cli.js scripts/verify-reader-growth-navigation.cjs",
    "test:reader:packaged": "node node_modules/electron/cli.js scripts/verify-packaged-reader.cjs",
    "test:reader:host": "node node_modules/electron/cli.js scripts/verify-reader-host.cjs",
    "test:reader:translation-reuse": "node node_modules/electron/cli.js scripts/verify-reader-translation-reuse.cjs",
    "test:reader:auth": "node node_modules/electron/cli.js scripts/verify-reader-session-auth.cjs",
    "test:reader:first-run": "node node_modules/electron/cli.js scripts/verify-reader-first-run.cjs",
    "prepare:reader-library": "node scripts/prepare-reader-library.mjs"
  },
  "dependencies": {
    "@react-spectrum/ai": "^0.4.0",
    "@react-spectrum/s2": "^1.8.2",
    "@vitejs/plugin-react": "^4.3.0",
    "@xmldom/xmldom": "0.9.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-cjk-friendly": "^2.3.3",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.2",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@electron/universal": "^3.0.6",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "electron": "^45.0.0",
    "esbuild": "0.25.12",
    "jsdom": "^29.1.1",
    "postcss": "8.5.31",
    "typescript": "^5.7.0",
    "unplugin-parcel-macros": "^0.2.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.12",
    "wait-on": "^8.0.0"
  }
}
