{
  "name": "vantilo",
  "version": "0.1.14",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/reader"
  ],
  "main": "electron/main.cjs",
  "scripts": {
    "prebuild": "node scripts/verify-workspace-build.mjs app",
    "prebuild:reader": "node scripts/verify-workspace-build.mjs reader",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "build:app-icon": "node scripts/build-app-icon.mjs",
    "typecheck": "tsc -b --pretty && npm run typecheck --workspace=@vantilo/reader",
    "test": "node scripts/run-tests-on-workspace.mjs",
    "test:workspace-infrastructure": "node scripts/run-tests-on-workspace.mjs --vitest tests/workspace-test-infrastructure.test.mjs",
    "test:e2e:codex": "node scripts/run-tests-on-workspace.mjs --node scripts/verify-real-codex-tools.cjs",
    "test:e2e:codex:passage": "node scripts/run-tests-on-workspace.mjs --node scripts/verify-real-codex-passage.cjs",
    "test:e2e:vocabulary-backup": "node scripts/run-tests-on-workspace.mjs --e2e scripts/run-vocabulary-backup-e2e.mjs",
    "package:e2e:vocabulary-backup": "node scripts/run-tests-on-workspace.mjs --node scripts/package-vocabulary-backup-e2e.mjs --keep-artifacts",
    "test:e2e:vocabulary-backup:packaged": "node scripts/run-tests-on-workspace.mjs --e2e scripts/run-vocabulary-backup-packaged-e2e.mjs",
    "test:e2e:vocabulary-backup:universal": "node scripts/run-tests-on-workspace.mjs --e2e scripts/run-vocabulary-backup-universal-e2e.mjs",
    "test:reader:offline": "node scripts/run-tests-on-workspace.mjs --reader",
    "test:cleanup": "node scripts/cleanup-workspace-test-run.mjs",
    "desktop": "electron .",
    "desktop:dev": "node scripts/build-reader-dev.mjs && node electron/dev.cjs",
    "build:reader": "node scripts/build-reader.mjs",
    "package:mac": "npm run build && npm run build:reader && node scripts/package-mac.mjs",
    "build:mac:beta": "node scripts/build-mac-beta-candidates.mjs",
    "build:mac:universal": "npm run build && npm run build:reader && node scripts/build-mac-universal.mjs",
    "package:reader:preview": "node scripts/package-reader-setup-preview.mjs",
    "stage:qwen:health": "node scripts/stage-reader-qwen-health.mjs",
    "package:qwen:preview": "node scripts/package-reader-qwen-preview.mjs",
    "test:qwen:preview": "node scripts/run-tests-on-workspace.mjs --electron scripts/verify-reader-qwen-preview.cjs",
    "test:qwen:resident": "node scripts/run-tests-on-workspace.mjs --electron scripts/verify-reader-qwen-resident.cjs",
    "test:reader:preview": "node scripts/run-tests-on-workspace.mjs --electron scripts/verify-reader-setup-preview.cjs",
    "test:reader:layout": "node scripts/run-tests-on-workspace.mjs --electron scripts/verify-reader-layout.cjs",
    "test:reader:growth-page": "node scripts/run-tests-on-workspace.mjs --electron scripts/verify-reader-growth-page-live.cjs",
    "test:reader:growth-navigation": "node scripts/run-tests-on-workspace.mjs --electron scripts/verify-reader-growth-navigation.cjs",
    "test:reader:packaged": "node scripts/run-tests-on-workspace.mjs --electron scripts/verify-packaged-reader.cjs",
    "test:reader:host": "node scripts/run-tests-on-workspace.mjs --electron scripts/verify-reader-host.cjs",
    "test:reader:translation-reuse": "node scripts/run-tests-on-workspace.mjs --electron scripts/verify-reader-translation-reuse.cjs",
    "test:reader:sentence-position": "node scripts/run-tests-on-workspace.mjs --electron scripts/verify-reader-sentence-position-restart.cjs",
    "test:reader:auth": "node scripts/run-tests-on-workspace.mjs --electron scripts/verify-reader-session-auth.cjs",
    "test:reader:first-run": "node scripts/run-tests-on-workspace.mjs --electron scripts/verify-reader-first-run.cjs",
    "test:reader:magazine-progress": "node scripts/run-tests-on-workspace.mjs --node scripts/verify-magazine-progress.cjs",
    "prepare:reader-library": "node scripts/prepare-reader-library.mjs"
  },
  "dependencies": {
    "@react-spectrum/ai": "^0.4.0",
    "@react-spectrum/s2": "^1.8.2",
    "@vitejs/plugin-react": "^4.3.0",
    "@xmldom/xmldom": "0.9.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-cjk-friendly": "^2.3.3",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.2",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@electron/universal": "^3.0.6",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "electron": "^45.0.0",
    "esbuild": "0.25.12",
    "jsdom": "^29.1.1",
    "postcss": "8.5.31",
    "typescript": "^5.7.0",
    "unplugin-parcel-macros": "^0.2.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.12",
    "wait-on": "^8.0.0"
  }
}
